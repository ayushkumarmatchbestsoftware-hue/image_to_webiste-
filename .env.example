# Pick ONE provider. LLM_PROVIDER is optional — if unset, the first key found wins.
#
#   provider    vision?  free tier   key to set
#   ---------------------------------------------------------------
#   gemini      yes      yes         GEMINI_API_KEY      <- recommended
#   groq        yes      yes         GROQ_API_KEY
#   openrouter  yes      yes         OPENROUTER_API_KEY
#   xai         yes      no          XAI_API_KEY
#   openai      yes      no          OPENAI_API_KEY
#   deepseek    NO       no          DEEPSEEK_API_KEY    <- cannot see photos
#
# Without vision the pipeline still runs: it falls back to reading colours and
# shape from the image locally, and asks the seller what the product is.

LLM_PROVIDER=gemini
GEMINI_API_KEY=paste_your_key_here

# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional model overrides
# LLM_MODEL_FAST=gemini-2.5-flash
# LLM_MODEL_CONTENT=gemini-2.5-flash
