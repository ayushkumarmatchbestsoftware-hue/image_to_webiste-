# Two lines is the whole configuration.
#
#   LLM_PROVIDER   which vendor
#   LLM_API_KEY    the key for that vendor
#
# Changing provider means changing those two and nothing else. The same key
# writes the copy AND edits the photographs, so there is no second setting to
# keep in step.

LLM_PROVIDER=gemini
LLM_API_KEY=paste_your_key_here


# ── Which provider ───────────────────────────────────────────────────────────
#
#   provider    vision?  free tier   edits photos?   key looks like
#   ---------------------------------------------------------------------
#   gemini      yes      yes         yes             AIza...     <- recommended
#   openai      yes      no          yes             sk-...
#   groq        yes      yes         no              gsk_...
#   openrouter  yes      yes         no              sk-or-...
#   xai         yes      no          no              xai-...
#   deepseek    NO       no          no              sk-...
#
# "vision" is whether the model can see the seller's photograph. Without it the
# pipeline still runs - it reads colour and shape from the image locally and
# asks the seller what the product is.
#
# "edits photos" is background replacement and scene staging. Where a provider
# has no image model the site still generates, using the local cutout instead.
#
# LLM_PROVIDER may be left out entirely: the key's own shape names the vendor.
# Set it anyway if you can - a DeepSeek key is indistinguishable from an
# OpenAI one, and being explicit costs a line.


# ── Optional ─────────────────────────────────────────────────────────────────
#
# Per-vendor key names still work and take priority over LLM_API_KEY, so an
# existing deployment does not have to change anything:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

# Override the models a provider uses by default.
# LLM_MODEL_FAST=
# LLM_MODEL_CONTENT=

# Edit photographs with a different vendor than the one writing the copy.
# IMAGE_PROVIDER=

# Where generated sites are written, and the URL their images are served from.
# STORE_DIR=
# PUBLIC_BASE_URL=

# Which languages a seller may choose. Defaults to the international set.
# SITE_LANGUAGES=en,es,fr,de,it,pt,nl,ru,ar,zh,ja,ko
